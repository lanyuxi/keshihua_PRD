{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:requirement-handoff:1.0",
  "title": "Requirement Handoff",
  "type": "object",
  "required": ["schema_version", "artifact_id", "product", "input_version", "source_artifacts", "requirements", "links", "open_questions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_id": {"type": "string", "minLength": 1},
    "product": {"type": "string", "minLength": 1},
    "input_version": {"type": "string", "minLength": 1},
    "source_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "version"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "source", "status", "roles", "business_rules", "acceptance_criteria"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "source": {"$ref": "#/$defs/locator"},
          "status": {"enum": ["ACTIVE", "RETIRED"]},
          "roles": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "business_rules": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "text"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "text": {"type": "string", "minLength": 1}
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirement_id", "target_type", "target_id"],
        "properties": {
          "requirement_id": {"type": "string", "minLength": 1},
          "target_type": {"enum": ["PROTOTYPE_ANCHOR", "ANNOTATION", "METRIC", "QUALITY_ISSUE", "ACCEPTANCE_CASE"]},
          "target_id": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question", "requirement_ids"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "requirement_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "locator": {
      "type": "object",
      "required": ["artifact", "type", "value"],
      "properties": {
        "artifact": {"type": "string", "minLength": 1},
        "type": {"enum": ["SOURCE_LINE", "HEADING", "PAGE", "PDF_REGION", "JSON_PATH", "DOM_SELECTOR", "IMAGE_REGION", "TIMESTAMP", "MISSING"]},
        "value": {"type": ["string", "integer"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
