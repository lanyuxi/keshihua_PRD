{
  "schema_version": "1.0",
  "product": {
    "name": "示例任务看板",
    "summary": "帮助团队创建、查看并跟踪任务。",
    "goal": "让任务状态与责任人保持透明。",
    "platforms": ["桌面端 Web", "移动端 Web"],
    "scope": ["任务列表", "任务详情", "创建任务"],
    "exclusions": ["复杂审批流程"]
  },
  "roles": [
    {
      "id": "owner",
      "name": "团队负责人",
      "description": "维护团队任务。",
      "permissions": ["创建任务", "查看任务详情"]
    }
  ],
  "modules": [
    {
      "id": "task-board",
      "title": "任务看板",
      "priority": "P0",
      "description": "集中展示与维护任务。",
      "requirement_ids": ["REQ-001"],
      "dependencies": []
    }
  ],
  "rules": [
    {
      "id": "RULE-001",
      "text": "任务名称不能为空。",
      "status": "CONFIRMED"
    }
  ],
  "acceptance_criteria": [
    {
      "id": "AC-001",
      "requirement_id": "REQ-001",
      "text": "负责人填写任务名称后可成功提交。",
      "status": "CONFIRMED"
    }
  ],
  "requirements": [
    {
      "id": "REQ-001",
      "module_id": "task-board",
      "title": "维护任务",
      "description": "负责人可以查看任务列表、进入详情并创建任务。",
      "user_stories": [
        {
          "role_id": "owner",
          "text": "我希望维护任务，以便团队明确下一步工作。"
        }
      ],
      "rule_ids": ["RULE-001"],
      "acceptance_ids": ["AC-001"],
      "state_machine": {
        "states": ["待处理", "进行中", "已完成"],
        "transitions": [
          {
            "from": "待处理",
            "action": "开始处理",
            "to": "进行中",
            "actor_role_id": "owner"
          }
        ]
      }
    }
  ],
  "prototype": {
    "initial_state": {},
    "pages": [
      {
        "id": "list",
        "title": "任务列表",
        "requirement_ids": ["REQ-001"],
        "components": [
          {
            "id": "list-hero",
            "type": "hero",
            "title": "任务看板",
            "description": "查看团队任务并快速创建新任务。",
            "requirement_ids": ["REQ-001"],
            "annotation": {
              "id": "task-overview",
              "order": 1,
              "scope": { "type": "page", "id": "list" },
              "title": "任务概览",
              "rule_refs": [],
              "acceptance_refs": []
            },
            "actions": [
              {
                "label": "新建任务",
                "action": "open-modal:create",
                "style": "primary",
                "annotation": {
                  "id": "create-entry",
                  "order": 2,
                  "scope": { "type": "page", "id": "list" },
                  "title": "创建入口",
                  "rule_refs": ["RULE-001"],
                  "acceptance_refs": ["AC-001"]
                }
              }
            ]
          },
          {
            "id": "task-list",
            "type": "table",
            "title": "任务列表",
            "description": "支持搜索、筛选和排序。",
            "list_id": "tasks",
            "controls": {
              "search": true,
              "filters": [
                {
                  "key": "status",
                  "options": [
                    { "label": "待处理", "value": "待处理" },
                    { "label": "进行中", "value": "进行中" }
                  ]
                }
              ]
            },
            "columns": [
              { "key": "title", "label": "任务" },
              { "key": "owner", "label": "负责人" },
              { "key": "status", "label": "状态" }
            ],
            "rows": [
              { "id": "task-1", "title": "完成方案评审", "owner": "负责人", "status": "进行中" },
              { "id": "task-2", "title": "整理用户反馈", "owner": "成员甲", "status": "待处理" }
            ],
            "row_action": "navigate:detail",
            "row_params": { "taskId": "{id}" }
          }
        ]
      },
      {
        "id": "detail",
        "title": "任务详情",
        "requirement_ids": ["REQ-001"],
        "components": [
          {
            "id": "detail-tabs",
            "type": "tabs",
            "title": "详情标签",
            "tabs": [
              { "id": "overview", "label": "概览", "content": "任务背景与当前状态。" },
              { "id": "history", "label": "历史", "content": "任务的变更记录。" }
            ]
          }
        ]
      }
    ],
    "modals": [
      {
        "id": "create",
        "page_id": "list",
        "title": "新建任务",
        "type": "dialog",
        "fields": [
          { "name": "title", "label": "任务名称", "type": "text", "required": true }
        ],
        "submit": {
          "label": "创建",
          "success_message": "任务已创建",
          "operation": "append",
          "target_list": "tasks",
          "record": {
            "id": "$auto",
            "title": "{title}",
            "owner": "未分配",
            "status": "待处理"
          }
        },
        "annotation": {
          "id": "create-form",
          "order": 1,
          "scope": { "type": "modal", "id": "create" },
          "title": "创建任务表单",
          "rule_refs": ["RULE-001"],
          "acceptance_refs": ["AC-001"]
        }
      }
    ]
  },
  "open_questions": []
}
